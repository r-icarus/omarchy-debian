# Debian port of upstream default/uwsm/env.d/10-omarchy.
# UWSM doesn't source /etc/profile.d — export the session env directly.

export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/share/omarchy}"
export OMARCHY_DEBIAN_PATH="${OMARCHY_DEBIAN_PATH:-$HOME/.local/share/omarchy-debian}"
# Quattro profile checkout (no-op when the profile was not installed).
export OMARCHY_QUATTRO_PATH="${OMARCHY_QUATTRO_PATH:-$HOME/.local/share/omarchy-quattro}"

# Overlay bin first (apt-backed omarchy-pkg-* shims), then upstream bin.
PATH="$OMARCHY_DEBIAN_PATH/overlay/bin:$OMARCHY_PATH/bin:$HOME/.local/bin:$PATH"
export PATH

export TERMINAL=xdg-terminal-exec
export EDITOR=nvim

# Upstream uses the Adwaita/default family. Pin a concrete complete theme,
# never the automatic alias that previously produced null cursor surfaces.
# Keep explicit user choices; retain Bibata as the known-good PikaOS fallback.
if [ -z "${XCURSOR_THEME:-}" ]; then
  if [ -s /usr/share/icons/Adwaita/cursors/left_ptr ] \
     && [ -s /usr/share/icons/Adwaita/cursors/pointer ] \
     && [ -s /usr/share/icons/Adwaita/cursors/text ] \
     && [ -s /usr/share/icons/Adwaita/cursors/wait ]; then
    export XCURSOR_THEME=Adwaita
  else
    export XCURSOR_THEME=Bibata-Modern-Classic
  fi
fi
export HYPRCURSOR_THEME="${HYPRCURSOR_THEME:-$XCURSOR_THEME}"
export XCURSOR_SIZE="${XCURSOR_SIZE:-24}"
export HYPRCURSOR_SIZE="${HYPRCURSOR_SIZE:-$XCURSOR_SIZE}"

[ -f "$HOME/.config/uwsm/default" ] && . "$HOME/.config/uwsm/default"
