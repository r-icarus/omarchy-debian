#!/bin/bash
# omarchy:summary=Remove a development environment (Debian package-aware wrapper).
# omarchy:args=<environment>
# omarchy:requires-sudo=true

set -euo pipefail

if [[ ${1:-} == php ]]; then
  # The upstream PHP removal path names Arch packages. Remove the mise runtime
  # only when present, then translate the old apt package names to Debian names
  # and pass only installed packages to apt-get.
  mise_php=$HOME/.local/share/mise/installs/php
  if [[ -d $mise_php ]]; then
    mise uninstall php --all
    mise rm -g php
    mise tool-alias unset php
  fi

  packages=()
  for pkg in php composer php-sqlite3 php-xdebug; do
    if [[ $(dpkg-query -W -f='${db:Status-Status}' "$pkg" 2>/dev/null || true) == installed ]]; then
      packages+=("$pkg")
    fi
  done
  if ((${#packages[@]})); then
    omarchy-pkg-drop "${packages[@]}"
  else
    echo "No apt-managed PHP packages are installed."
  fi
  echo "PHP has been removed."
  exit 0
fi

upstream=${OMARCHY_PATH:-$HOME/.local/share/omarchy}
remover=$upstream/bin/omarchy-remove-dev-env
if [[ ! -x $remover ]]; then
  echo "Error: upstream development remover not found at $remover." >&2
  exit 1
fi
exec "$remover" "$@"
