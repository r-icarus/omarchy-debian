index 411620a..6a82cad 100755
--- a/bin/omarchy-language
+++ b/bin/omarchy-language
@@ -88,6 +88,13 @@ generate_locale() {
   local code=$1 locale=$2
   locale_generated "$locale" && return

+  # Debian checkouts have no packaged /usr/share/omarchy registry. Elevate
+  # only the system localedef binary, never a helper from the user checkout.
+  if command -v omarchy-debian-locale-ensure >/dev/null 2>&1; then
+    omarchy-debian-locale-ensure "$locale"
+    return
+  fi
+
   if (( EUID == 0 )); then
     "$generator" "$code"
   elif generator_is_passwordless "$code"; then
